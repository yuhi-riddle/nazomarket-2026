{
  "name": "nazomarket-shared-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-28",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "SharedRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SharedRoom"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173"
  }
}
