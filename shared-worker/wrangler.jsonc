{
  "name": "nazomarket-shared-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-28",
  "ratelimits": [
    {
      "name": "ROOM_CREATE_RATE_LIMIT",
      "namespace_id": "2026102801",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "ROOM_READ_RATE_LIMIT",
      "namespace_id": "2026102802",
      "simple": { "limit": 1800, "period": 60 }
    },
    {
      "name": "ROOM_OPERATION_RATE_LIMIT",
      "namespace_id": "2026102803",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "SharedRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SharedRoom"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173"
  }
}
